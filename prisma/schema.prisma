generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------
enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum StoreType {
  GENERAL
  SHOP
  CAFE
  RESTAURANT
  NAIL_BEAUTY
  TRAVEL
  LOGISTICS
  POS
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

// ---------- assets (generic equipment / resource foundation) ----------
// Generic, tenant-scoped physical/business resource. Deliberately has NO
// rental/booking/invoice fields — those belong to future business modules.
// `type` is a free-form string so any vertical (crane, POS terminal, etc.)
// can be represented without a schema migration.
enum AssetStatus {
  ACTIVE
  INACTIVE
}

model Asset {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  code        String // short code, unique within the tenant
  type        String // free-form category (crane, vehicle, terminal, ...)
  description String?
  status      AssetStatus @default(ACTIVE)
  settings    Json? // generic per-asset config; no business-specific fields
  storeId     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Optional Store must belong to the SAME tenant. Read scoping (tenant-scoping
  // extension) and application-layer validation enforce cross-tenant storeId
  // rejection (resolves to null -> 404); the extension injects `tenantId`
  // from TenantContext on every write so it can never be set from payload.
  store  Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  // Phase 2J keyset pagination: ordered scan on (createdAt, id) within the
  // tenant avoids a per-page sort and seeks past the cursor tuple.
  @@index([tenantId, createdAt, id])
  @@index([storeId])
  equipment Equipment?
}

// ---------- equipment (rentable equipment identity on top of Asset) ----------
// 1:1 specialization of a generic Asset for physical rentable equipment
// (crane, excavator, forklift). Kept in its own model so the generic Asset
// foundation stays free of equipment-specific columns. Identity fields only -
// no rental workflow data (bookings/contracts/pricing belong to future
// modules).
enum EquipmentType {
  CRANE
  EXCAVATOR
  FORKLIFT
}

model Equipment {
  id       String        @id @default(cuid())
  tenantId String
  // 1:1 link to a same-tenant Asset; the globally unique assetId guarantees
  // at most one equipment record per asset. Deleting the Asset cascades here.
  assetId  String        @unique
  type     EquipmentType

  manufacturer String? // free-form make designation
  model        String? // free-form model designation
  serialNumber String? // unique within the tenant when present
  year         Int?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // The application layer resolves assetId through a tenant-scoped Asset lookup,
  // so a cross-tenant or unknown asset is rejected (404) before any write;
  // DB-level consistency is additionally backed by this foreign key.
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  // Phase 2J keyset pagination (see Asset).
  @@index([tenantId, createdAt, id])
  reservations Reservation[]
}

// ---------- customers (rental counterparties) ----------
// Tenant-scoped registry of rental counterparties. Identity/contact fields
// only - no booking/rental data (reservations/pricing belong to future
// modules). Email is deliberately NOT unique: a global unique constraint
// would leak cross-tenant existence.
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id       String         @id @default(uuid())
  tenantId String
  name     String
  code     String // short code, unique within the tenant
  email    String?
  phone    String?
  notes    String?
  status   CustomerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  // Phase 2J keyset pagination (see Asset).
  @@index([tenantId, createdAt, id])
  reservations Reservation[]
  orders       Order[]
}

// ---------- reservations (time-bound holds on rentable equipment) ----------
// One reservation holds ONE Equipment item for ONE Customer over a half-open
// [startAt, endAt) UTC interval. No pricing/invoice/pickup/return data - those
// belong to future modules. ACTIVE/COMPLETED are declared for the upcoming
// rental workflow but are unreachable through the API in this phase.
// NOTE: the database adds a btree_gist EXCLUDE constraint and a CHECK
// constraint (see migration 20260821020000_add_reservation_domain) that the
// Prisma schema DSL cannot express. Deploy-only migration discipline is
// mandatory: `prisma migrate dev/diff` would try to drop them.
enum ReservationStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Reservation {
  id          String            @id @default(uuid())
  tenantId    String
  customerId  String
  equipmentId String
  startAt     DateTime
  endAt       DateTime
  status      ReservationStatus @default(RESERVED)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Business history must survive counterparty removal: RESTRICT blocks
  // deleting a Customer that still has reservations (application layer maps
  // the resulting P2003 to 409).
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Same protection for the rented item: an Asset/Equipment with reservations
  // cannot be deleted (the Asset->Equipment cascade is blocked by RESTRICT).
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([equipmentId, startAt])
  // Phase 2J keyset pagination: default (createdAt, id) order plus the
  // approved sortBy=startAt alternative.
  @@index([tenantId, createdAt, id])
  @@index([tenantId, startAt, id])
}

// ---------- commerce: categories (Phase 3 U1) ----------
// Tenant-scoped product taxonomy. Flat list, unique name within the tenant.
// Deliberately minimal: no nesting, no slugs, no images — nothing beyond what
// the approved Phase 3 scope requires.
model Category {
  id          String  @id @default(cuid())
  tenantId    String
  name        String // unique within the tenant
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  // Keyset pagination parity with all other tenant-scoped lists.
  @@index([tenantId, createdAt, id])
}

// ---------- commerce: products (Phase 3 U2) ----------
// Tenant-scoped catalog item. Since U3 a product owns variants (Cascade);
// prices hang off variants.
model Product {
  id       String  @id @default(cuid())
  tenantId String
  // Optional taxonomy link, same-tenant only (Restrict at DB level).
  categoryId String?
  name     String
  code     String // unique within the tenant
  description String?

  status ProductStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants ProductVariant[]

  @@unique([tenantId, code])
  @@index([tenantId])
  // Keyset pagination parity with all other tenant-scoped lists.
  @@index([tenantId, createdAt, id])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ---------- commerce: variants + prices (Phase 3 U3) ----------
// A Product sells through its variants; each variant carries the SKU-level
// identity and a set of CURRENT prices (one row per currency). Prices are
// live values only: an upsert overwrites, NO history is kept — order-time
// snapshots arrive with OrderItem (U6). Money is always integer minor units
// (BigInt -> BIGINT), serialized as strings in JSON projections.
enum VariantStatus {
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id        String @id @default(cuid())
  tenantId  String
  productId String
  sku       String // unique within the tenant
  name      String?

  status VariantStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  prices     Price[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  // Keyset pagination parity with all other tenant-scoped lists.
  @@index([tenantId, createdAt, id])
}

model Price {
  id          String @id @default(cuid())
  tenantId    String
  variantId   String
  // ISO-4217 uppercase alpha-3, stored CHAR(3).
  currency    String @db.Char(3)
  // Exact integer minor units; never a float. Serialized as STRING in JSON.
  amountMinor BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // One CURRENT price per (variant, currency); updates overwrite it.
  @@unique([variantId, currency])
  @@index([tenantId])
  // Keyset pagination parity with all other tenant-scoped lists.
  @@index([tenantId, createdAt, id])
}

// ---------- commerce: inventory (Phase 3 U4) ----------
// Single stock pool per variant, no multi-location. Row is created lazily
// on first adjustment (missing row == 0 on hand). Mutations are atomic
// guarded conditional writes; DB CHECK prevents negative stock.
model Inventory {
  id             String @id @default(cuid())
  tenantId       String
  variantId      String @unique
  quantityOnHand Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt, id])
}

// ---------- commerce: cart (Phase 3 U5) ----------
// Owner = authenticated member User, tenant-scoped. One OPEN cart per
// (tenant,user) enforced find-or-create. Items merge by @@unique([cartId,variantId]).
// Prices are live from Price rows at read time; cart holds NO money fields.
enum CartStatus {
  OPEN
  CONVERTED
}

model Cart {
  id       String     @id @default(cuid())
  tenantId String
  userId   String
  status   CartStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@index([tenantId])
  @@index([tenantId, userId, status])
  @@index([tenantId, createdAt, id])
}

model CartItem {
  id        String @id @default(cuid())
  tenantId  String
  cartId    String
  variantId String
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([tenantId])
  @@index([cartId])
  @@index([variantId])
}

// ---------- commerce: orders (Phase 3 U6) ----------
// Order is financial history: PENDING -> PAID|CANCELLED, PAID terminal.
// Stock is decremented atomically on creation and restocked on cancel.
// Snapshots preserve product/variant names and pricing at order time.
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  userId      String
  customerId  String?
  status      OrderStatus @default(PENDING)
  currency    String      @db.Char(3)
  subtotalMinor BigInt
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, status])
  @@index([customerId])
}

model OrderItem {
  id              String @id @default(cuid())
  tenantId        String
  orderId         String
  variantId       String
  productName     String
  variantName     String?
  sku             String
  quantity        Int
  currency        String @db.Char(3)
  unitAmountMinor BigInt
  lineTotalMinor  BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([orderId])
  @@index([variantId])
}

// ---------- commerce: payments (Phase 3 U7) ----------
// Payment records for order capture. Simulated gateway only (no external providers).
// Status: PROCESSING -> CAPTURED | FAILED (terminal, immutable).
// Amount/currency derived from Order at creation (full-amount invariant).
enum PaymentStatus {
  PROCESSING
  CAPTURED
  FAILED
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  orderId     String
  status      PaymentStatus @default(PROCESSING)
  method      String
  amountMinor BigInt
  currency    String        @db.Char(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt, id])
  @@index([orderId])
}

// ---------- identity ----------
model User {
  id           String       @id @default(cuid())
  email        String       @unique // persisted normalized: lowercase + trimmed (enforced in service layer)
  passwordHash String? // nullable for future OAuth/SSO/magic-link identities
  firstName    String?
  lastName     String?
  status       UserStatus   @default(ACTIVE)
  memberships  Membership[]
  refreshTokens RefreshToken[]
  carts        Cart[]
  orders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------- refresh tokens (auth session rotation) ----------
// One row per issued refresh token. Only the sha256 hash of the token
// material is ever persisted — never the raw token. Rotation marks the old
// row revokedAt; rows are retained for reuse detection.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  settings    Json? // generic extension point; never business-specific columns
  memberships Membership[]
  roles       Role[]
  stores      Store[]
  assets      Asset[]
  equipments  Equipment[]
  customers   Customer[]
  reservations Reservation[]
  categories  Category[]
  products    Product[]
  productVariants ProductVariant[]
  prices      Price[]
  inventories Inventory[]
  carts       Cart[]
  cartItems   CartItem[]
  orders      Order[]
  orderItems  OrderItem[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- membership ----------
model Membership {
  id       String           @id @default(cuid())
  userId   String
  tenantId String
  roleId   String // required: "A Membership has a Role"
  status   MembershipStatus @default(ACTIVE)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // COMPOSITE FK - DB-level guarantee: a membership can only reference a Role
  // that belongs to the SAME tenant as the membership.
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

// ---------- RBAC ----------
model Role {
  id          String  @id @default(cuid())
  tenantId    String // tenant-scoped roles
  key         String // stable code ("owner", "admin", "employee") - authorization checks keys, never names
  name        String
  description String?
  isSystem    Boolean @default(false) // seeded system role; immutable for tenant admins

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // required composite unique - the target of Membership's composite FK
  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // global catalog, platform-defined ("store:read", "order:create", ...)
  name        String
  description String?
  category    String? // grouping: "store", "settings", ...

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---------- organization (generic business unit) ----------
model Store {
  id       String      @id @default(cuid())
  tenantId String
  name     String
  code     String // short code, unique within the tenant
  type     StoreType   @default(GENERAL) // generic classifier only - carries NO business data
  status   StoreStatus @default(ACTIVE)
  settings Json? // generic per-store config; no business-specific fields

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  // Phase 2J keyset pagination (see Asset).
  @@index([tenantId, createdAt, id])
  @@index([type])
  assets Asset[]
}
