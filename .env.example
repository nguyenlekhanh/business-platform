# Runtime
NODE_ENV=development
PORT=3000

# Database (PostgreSQL / Prisma)
# When running through Docker Compose use:
#   postgresql://app:app@postgres:5432/app?schema=public
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Auth (JWT)
# Use a long random string (min 32 chars); rotate in production.
JWT_SECRET=change-me-to-a-secure-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
