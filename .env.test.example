# Test environment variables (loaded by test/setup-env.ts)
NODE_ENV=test
PORT=3100
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
LOG_LEVEL=silent
LOG_PRETTY=false
JWT_SECRET=test-jwt-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
